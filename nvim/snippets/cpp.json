  "Pre-Defined CP Template": {
    "prefix": "rollin",
    "body": [
      "#include <bits/stdc++.h>",
      "using namespace std;",
      "#define int long long",
      "",
      "class DSU {",
      "public:",
      "  vector<int> parent, csize;",
      "",
      "  DSU(int n) {",
      "    parent.resize(n+1);",
      "    iota(parent.begin(), parent.end(), 0);",
      "    csize.resize(n+1, 1);",
      "  }",
      "",
      "  int findroot(int u) {",
      "    if (parent[u] == u) return u;",
      "    return parent[u] = findroot(parent[u]);",
      "  }",
      "",
      "  void unite(int u, int v) {",
      "    u = findroot(u);",
      "    v = findroot(v);",
      "",
      "    if (u == v) return;",
      "",
      "    // u is larger comp",
      "    if (csize[u] < csize[v]) swap(u, v);",
      "",
      "    csize[u] += csize[v];",
      "    parent[v] = u;",
      "  }",
      "};",
      "",
      "class SegmentTree {",
      "public:",
      "  vector<int> tree;",
      "  int n;",
      "",
      "  SegmentTree(int N) {",
      "    tree.assign(2*N, 0); // or 4*N for balanced tree",
      "    n = N;",
      "  }",
      "",
      "  void build(vector<int>& arr) {",
      "    // leaf nodes",
      "    for (int i = 0; i < n; i++) {",
      "      tree[n+i] = arr[i];",
      "    }",
      "",
      "    // build upwards",
      "    for (int i = n-1; i > 0; i--) {",
      "      tree[i] = tree[2*i] + tree[2*i +1]; // tree[1<<i] + tree[1<<i |1]",
      "    }",
      "  }",
      "",
      "  void update(int p, int val) {",
      "    // set val at zero-indexed position p (leaf node)",
      "    p += n;",
      "    tree[p] = val;",
      "",
      "    // update upwards",
      "    while (p > 1) {",
      "      // move to it's parent",
      "      p >>= 1; // p /= 2;",
      "      tree[p] = tree[2*p] + tree[2*p +1]; // tree[p<<1] + tree[p<<1 |1]",
      "    }",
      "  }",
      "",
      "  // result for 0-indexed semi-open interval [l, r)",
      "  int query(int l, int r) {",
      "    int ans = 0;",
      "",
      "    // move pointers to leaf node in tree",
      "    l += n; ",
      "    r += n;",
      "",
      "    while (l < r) {",
      "      // if l is right child",
      "      if (l & 1) {",
      "        ans += tree[l];",
      "        l++;",
      "      }",
      "",
      "      // if r is right child (exclusive)",
      "      if (r & 1) {",
      "        r--;",
      "        ans += tree[r];",
      "      }",
      "",
      "      // move upwards to parents",
      "      l >>= 1; // l /= 2;",
      "      r >>= 1; // r /= 2;",
      "    }",
      "",
      "    return ans;",
      "  }",
      "};",
      "",
      "void space() {",
      "  int n$0;",
      "  cin >> n;",
      "",
      "  vector<int> arr(n);",
      "  for (int &x : arr) cin >> x;",
      "",
      "",
      "}",
      "",
      "int32_t main() {",
      "  ios::sync_with_stdio(false);",
      "  cin.tie(nullptr);",
      "",
      "  int t = 1;",
      "  cin >> t;",
      "",
      "  while (t--) {",
      "    space();",
      "    cout << '\\n';",
      "  }",
      "",
      "  return 0;",
      "}"
    ],
    "description": "pre-defined cp template"
  },

